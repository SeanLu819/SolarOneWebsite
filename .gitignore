public/favicon.webp

# Unused logo VARIANTS (kept locally but not deployed) — ONLY *.png variants!
# DO NOT ignore .webp — those are the actual deployed assets!
static/images/logo-original.png
static/images/logo.final.png
static/images/logo.original-compressed.png

# Orphan image directory (not under static/, not served)
/images/

