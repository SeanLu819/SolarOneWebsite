# =============================================================================
# SolarOne Website — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# On Vercel, set these as Project Environment Variables (Settings → Env Vars).
# =============================================================================

# Required on Vercel (production). If not set, the app will refuse to start.
# Generate a strong secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to "true" to enable Django DEBUG mode (default: false).
# On Vercel, DEBUG is always False regardless of this setting.
DEBUG=false

# Set to "1" when running on Vercel (usually auto-detected by the platform).
VERCEL=

# Comma-separated list of allowed hostnames.
# The default covers Vercel's domain, the live site, and localhost.
ALLOWED_HOSTS=.vercel.app,.solaronelighting.com,localhost,127.0.0.1

# Trusted origins for CSRF protection (must include full scheme+host).
CSRF_TRUSTED_ORIGINS=https://solar-one-website.vercel.app,https://www.solaronelighting.com,https://solaronelighting.com

# --- Optional: Email notifications for contact form submissions ---
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# CONTACT_NOTIFY_EMAIL=sales@solaronelighting.com
