{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": {
        "buildCommand": "bash build.sh"
      }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/index.py" },
    { "src": "/media/(.*)",  "dest": "/index.py" },
    { "src": "/(.*)",        "dest": "/index.py" }
  ]
}