{
  "buildCommand": "bash build.sh",
  "outputDirectory": "public",
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": "**"
      }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.py" }
  ]
}