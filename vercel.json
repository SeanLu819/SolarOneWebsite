{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": {
        "installCommand": "bash build.sh"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/favicon.ico", "dest": "/public/favicon.webp" },
    { "src": "/favicon.png", "dest": "/public/favicon.webp" },
    { "src": "/(.*)", "dest": "/index.py" }
  ]
}