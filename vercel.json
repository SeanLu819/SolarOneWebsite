{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash build.sh",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{static,staticfiles,media,docs,screenshots}/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
